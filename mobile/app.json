{
  "expo": {
    "name": "Travelie",
    "slug": "travelie",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travelie",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B1F1C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.travelie.mobile",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "app.travelie.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F1C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F1C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Travelie uses your photo library so you can choose a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}