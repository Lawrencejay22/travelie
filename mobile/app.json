{
  "expo": {
    "name": "Travelie",
    "slug": "travelie",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travelie",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B1F1C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.travelie.mobile",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "app.travelie.mobile",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1F1C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F1C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Travelie uses your camera for compass-guided destination previews.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Travelie uses your location to find nearby places and guide you to destinations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Travelie uses your photo library so you can choose a profile picture."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e907b3aa-a96f-4cc3-a2e0-4f5e600e28cb"
      }
    }
  }
}
